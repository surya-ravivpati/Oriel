    "validate:speech": "tsx --tsconfig tsconfig.json scripts/validate-speech.ts",
    "validate:camera": "playwright test --config playwright.validation.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "mammoth": "^1.13.0",
    "motion": "^13.4.6",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "postcss": "^8.5.28",
