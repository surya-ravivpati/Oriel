# ─── Oriel environment ────────────────────────────────────────────────────────
# Copy to .env.local for development. Never commit real credentials.

# Server secret used to derive per-user media encryption keys, signed media URLs.
# REQUIRED in production (>= 32 random chars):  openssl rand -base64 48
ORIEL_SECRET=

# Comma-separated emails that get the admin/debug console. In development the first
# account created is also an admin.
ORIEL_ADMIN_EMAILS=

# ─── AI providers (server-side only; never exposed to the browser) ──────────
# Google Gemini: interviewer language model, TTS voice, answer transcription.
GEMINI_API_KEY=
# Optional model overrides (defaults were measured for latency on 2026-09-29):
# GEMINI_REALTIME_MODEL=gemini-3.1-flash-lite
# GEMINI_REALTIME_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_FALLBACK_MODEL=gemini-3.8-flash-tts
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Requests/minute your TTS quota allows (free-tier keys: 10). Prewarming respects it.
# ORIEL_TTS_RPM=10

# Optional Claude adapter for the language model (ORIEL_LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
# ORIEL_LLM_PROVIDER=gemini|anthropic|mock
# ANTHROPIC_REALTIME_MODEL=claude-opus-5
# ANTHROPIC_ANALYSIS_MODEL=claude-opus-5
# ORIEL_TTS_PROVIDER=gemini|browser
# ORIEL_STT_PROVIDER=gemini|browser

# Managed real-time avatar vendor (optional). Without it the on-device WebGL
# interviewer is used. See src/lib/avatar/external-provider.ts.
AVATAR_PROVIDER=
AVATAR_PROVIDER_API_KEY=

# ─── Storage ───────────────────────────────────────────────────────────────
# DATABASE_PATH=data/oriel.db
# MEDIA_DIR=data/media

# ─── Billing ───────────────────────────────────────────────────────────────
# dev = plan changes apply instantly with no charge (default outside production).
# ORIEL_PAYMENTS=dev
STRIPE_SECRET_KEY=

# ─── On-device perception models (optional overrides) ──────────────────────
# NEXT_PUBLIC_MEDIAPIPE_FACE_MODEL=
# NEXT_PUBLIC_MEDIAPIPE_POSE_MODEL=
